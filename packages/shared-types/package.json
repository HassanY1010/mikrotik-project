{
  "name": "@mikrotik-saas/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types and interfaces for the MikroTik SaaS platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
