generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  EXPIRED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  CASHIER
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RouterOsVersion {
  V6
  V7
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
  CONNECTING
}

enum AgentStatus {
  ONLINE
  OFFLINE
  REVOKED
}

enum CardStatus {
  GENERATED
  AVAILABLE
  SOLD
  ACTIVE
  EXPIRED
  DISABLED
}

enum CardBatchStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_WALLET
  TRANSFER
}

enum PrintJobStatus {
  PENDING
  PRINTING
  COMPLETED
  FAILED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum PppoeAccountStatus {
  ACTIVE
  DISABLED
  EXPIRED
  SUSPENDED
}

enum ExpenseCategory {
  INTERNET_UPSTREAM
  ELECTRICITY
  PAPER_AND_INK
  HARDWARE_MAINTENANCE
  SALARIES
  COMMISSIONS
  RENT
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  REFUNDED
}

// =============================================================================
// PLATFORM & MULTI-TENANCY CORE
// =============================================================================

model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  logoUrl      String?
  status       TenantStatus @default(ACTIVE)
  currency     String       @default("SDG")
  address      String?
  phone        String?
  contactEmail String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  walletBalance    Decimal                  @default(0) @db.Decimal(12, 2)
  loyaltyPoints    Int                      @default(0)
  allowAdminCards  Boolean                  @default(false)

  // Relations
  users            User[]
  roles            Role[]
  subscriptions    Subscription[]
  devices          MikroTikDevice[]
  hotspotProfiles  HotspotProfile[]
  cardBatches      CardBatch[]
  cards            Card[]
  cardTemplates    CardTemplate[]
  saleTransactions SaleTransaction[]
  printJobs        PrintJob[]
  auditLogs        AuditLog[]
  activeSessions   HotspotActiveSession[]
  walletTransactions TenantWalletTransaction[]
  deviceAgents       DeviceAgent[]
  agentPairingCodes  AgentPairingCode[]
  agentCommands      AgentCommand[]
  pppoeProfiles      PppoeProfile[]
  pppoeAccounts      PppoeAccount[]
  pppoeActiveSessions PppoeActiveSession[]
  expenses           Expense[]
  staffInvitations   StaffInvitation[]

  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String   @unique // BASIC, PRO, BUSINESS
  nameAr       String
  description  String?
  maxRouters   Int      @default(1)
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal  @db.Decimal(10, 2)
  features     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id           String             @id @default(uuid())
  tenantId     String
  planId       String
  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)
  startsAt     DateTime           @default(now())
  expiresAt    DateTime
  maxRouters   Int                @default(1)
  price        Decimal            @db.Decimal(10, 2)
  approvedBy   String?            // Super Admin user ID who manually activated it
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// =============================================================================
// IDENTITY, USERS & RBAC
// =============================================================================

model User {
  id           String     @id @default(uuid())
  tenantId     String?    // null for Super Admin platform operators
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  roleId       String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs          AuditLog[]
  cardBatchesCreated CardBatch[]       @relation("CreatedBy")
  cardsSold          Card[]            @relation("SoldBy")
  saleTransactions   SaleTransaction[]
  printJobs          PrintJob[]
  expensesCreated    Expense[]
  deviceAccess       UserDeviceAccess[]
  userPermissions    UserPermission[]
  createdInvitations StaffInvitation[]  @relation("CreatedInvitations")

  @@index([tenantId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  // null for system default roles
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]
  staffInvitations StaffInvitation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "cards:create", "devices:manage"
  name        String
  description String?
  module      String   // e.g. "cards", "devices", "sales", "tenants"
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserDeviceAccess {
  userId    String
  deviceId  String
  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("user_device_access")
}

model UserPermission {
  userId       String
  permissionId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model StaffInvitation {
  id          String    @id @default(uuid())
  tenantId    String
  email       String
  fullName    String
  phone       String?
  roleId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id])
  createdBy User   @relation("CreatedInvitations", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tokenHash])
  @@index([email])
  @@map("staff_invitations")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// MIKROTIK ROUTEROS & HOTSPOT NETWORK
// =============================================================================

model MikroTikDevice {
  id                String          @id @default(uuid())
  tenantId          String
  name              String
  host              String
  apiPort           Int             @default(8728)
  restPort          Int             @default(443)
  useSsl            Boolean         @default(false)
  username          String
  passwordEncrypted String          // Encrypted with AES-256-GCM
  iv                String          // Hex IV
  authTag           String          // Hex authentication tag
  rosVersion        RouterOsVersion @default(V7)
  isOnline          Boolean         @default(false)
  status            DeviceStatus    @default(OFFLINE)
  lastSyncAt        DateTime?
  lastError         String?
  cpuLoad           Int?
  memoryFree        BigInt?
  memoryTotal       BigInt?
  diskFree          BigInt?
  diskTotal         BigInt?
  uptime            String?
  modelName         String?
  isLocked          Boolean         @default(false)
  antiTetheringEnabled Boolean      @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profiles       HotspotProfile[]
  cardBatches    CardBatch[]
  cards          Card[]
  activeSessions HotspotActiveSession[]
  sales          SaleTransaction[]
  agents         DeviceAgent[]
  pairingCodes   AgentPairingCode[]
  agentCommands  AgentCommand[]
  pppoeProfiles  PppoeProfile[]
  pppoeAccounts       PppoeAccount[]
  pppoeActiveSessions PppoeActiveSession[]
  userAccess          UserDeviceAccess[]

  @@unique([tenantId, host, apiPort])
  @@index([tenantId])
  @@index([status])
  @@index([isOnline])
  @@map("mikrotik_devices")
}

model HotspotProfile {
  id               String   @id @default(uuid())
  tenantId         String
  deviceId         String
  name             String   // e.g. "1hour-unlimited", "1day-500mb"
  rateLimit        String?  // e.g. "2M/2M"
  sessionTimeout   String?  // e.g. "1h"
  idleTimeout      String?  // e.g. "5m"
  keepaliveTimeout String?
  sharedUsers      Int      @default(1)
  addressPool      String?
  dataLimitBytes   BigInt?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device      MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  cardBatches CardBatch[]
  cards       Card[]

  @@unique([tenantId, deviceId, name])
  @@index([tenantId])
  @@index([deviceId])
  @@map("hotspot_profiles")
}

model HotspotActiveSession {
  id            String   @id @default(uuid())
  tenantId      String
  deviceId      String
  cardId        String?
  username      String
  ipAddress     String
  macAddress    String
  uptimeSeconds Int      @default(0)
  bytesIn       BigInt   @default(0)
  bytesOut      BigInt   @default(0)
  startedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  card   Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([deviceId])
  @@index([cardId])
  @@index([macAddress])
  @@map("hotspot_active_sessions")
}

// =============================================================================
// PREPAID CARDS, BATCHES & PRINTING
// =============================================================================

model CardTemplate {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  widthMm          Int      @default(85)
  heightMm         Int      @default(54)
  orientation      String   @default("landscape")
  backgroundDesign String?
  themePreset      String?  @default("CLASSIC")
  primaryColor     String?  @default("#1E3A8A")
  accentColor      String?  @default("#10B981")
  layoutConfig     Json     // QR code, PIN, serial, price, network name placements
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printJobs PrintJob[]

  @@index([tenantId])
  @@map("card_templates")
}

model CardBatch {
  id             String          @id @default(uuid())
  tenantId       String
  deviceId       String
  profileId      String
  batchNumber    String          @unique
  totalCards     Int
  prefix         String?
  length         Int             @default(8)
  pattern        String          @default("NUMERIC") // NUMERIC, ALPHANUMERIC
  price          Decimal         @db.Decimal(10, 2)
  unitCost       Decimal?        @default(0) @db.Decimal(10, 2)
  validityDays   Int?
  timeLimit      String?
  dataLimitBytes BigInt?
  status         CardBatchStatus @default(PROCESSING)
  themePreset    String?         @default("FOOTBALL")
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  profile   HotspotProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy User           @relation("CreatedBy", fields: [createdById], references: [id])
  cards     Card[]
  printJobs PrintJob[]

  @@index([tenantId])
  @@index([deviceId])
  @@index([profileId])
  @@index([status])
  @@map("card_batches")
}

model Card {
  id                String     @id @default(uuid())
  tenantId          String
  batchId           String
  deviceId          String
  profileId         String
  username          String
  passwordEncrypted String     // AES-256-GCM encrypted
  iv                String     // Hex IV
  authTag           String     // Hex auth tag
  pinCode           String?
  serialNumber      String     @unique
  price             Decimal    @db.Decimal(10, 2)
  unitCost          Decimal?   @default(0) @db.Decimal(10, 2)
  validityDays      Int?
  timeLimit         String?
  dataLimitBytes    BigInt?
  status            CardStatus @default(AVAILABLE)
  isPrinted         Boolean    @default(false)
  printedAt         DateTime?
  soldAt            DateTime?
  soldById          String?
  activatedAt       DateTime?
  expiresAt         DateTime?
  syncStatus        SyncStatus @default(PENDING)
  syncError         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch          CardBatch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  device         MikroTikDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  profile        HotspotProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  soldBy         User?                  @relation("SoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  sales          SaleTransaction[]
  activeSessions HotspotActiveSession[]

  @@unique([tenantId, deviceId, username])
  @@index([tenantId])
  @@index([batchId])
  @@index([deviceId])
  @@index([status])
  @@index([isPrinted])
  @@index([syncStatus])
  @@index([soldAt])
  @@index([tenantId, status])
  @@index([tenantId, batchId, status])
  @@index([tenantId, deviceId, status])
  @@index([tenantId, createdAt])
  @@map("cards")
}

// =============================================================================
// SALES TRANSACTIONS & PRINT JOBS
// =============================================================================

model SaleTransaction {
  id              String        @id @default(uuid())
  tenantId        String
  cardId          String
  cashierId       String
  deviceId        String
  amount          Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  remainingAmount Decimal       @default(0) @db.Decimal(10, 2)
  currency        String        @default("SDG")
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PAID)
  customerPhone   String?
  customerName    String?
  distributorName String?
  notes           String?
  invoiceNumber   String        @unique
  printedCount    Int           @default(0)
  lastPrintedAt   DateTime?
  createdAt       DateTime      @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card    Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cashier User           @relation(fields: [cashierId], references: [id])
  device  MikroTikDevice @relation(fields: [deviceId], references: [id])

  @@index([tenantId])
  @@index([cashierId])
  @@index([deviceId])
  @@index([cardId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, cashierId, createdAt])
  @@index([tenantId, deviceId, createdAt])
  @@map("sale_transactions")
}

model PrintJob {
  id           String         @id @default(uuid())
  tenantId     String
  templateId   String
  cardBatchId  String?
  singleCardId String?
  printerType  String         @default("THERMAL") // THERMAL, A4_SHEET, ESC_POS
  status       PrintJobStatus @default(PENDING)
  totalCards   Int            @default(1)
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template  CardTemplate  @relation(fields: [templateId], references: [id])
  cardBatch CardBatch?    @relation(fields: [cardBatchId], references: [id], onDelete: SetNull)
  createdBy User          @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("print_jobs")
}

model Expense {
  id            String          @id @default(uuid())
  tenantId      String
  title         String
  category      ExpenseCategory @default(OTHER)
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("SDG")
  expenseDate   DateTime        @default(now())
  paymentMethod PaymentMethod   @default(CASH)
  vendor        String?
  description   String?
  receiptUrl    String?
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
  @@map("expenses")
}

model TenantWalletTransaction {
  id           String   @id @default(uuid())
  tenantId     String
  amount       Decimal  @db.Decimal(12, 2)
  type         String   // RECHARGE, USAGE, BONUS, ADJUSTMENT
  pointsDelta  Int      @default(0)
  balanceAfter Decimal  @db.Decimal(12, 2)
  reference    String?
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
  @@map("tenant_wallet_transactions")
}

// =============================================================================
// SUDAFI LAN AGENT (REMOTE CONNECTIVITY)
// =============================================================================

model DeviceAgent {
  id         String      @id @default(uuid())
  tenantId   String
  deviceId   String      // Indexed for fast lookup of router's agents
  name       String      // Host machine name (e.g. "Cashier-POS-PC")
  tokenHash  String      @unique // SHA-256 Hash of AgentAuthToken
  status     AgentStatus @default(OFFLINE)
  version    String?     // Agent version
  ipAddress  String?     // Last seen external IP
  lastPingAt DateTime?
  pairedAt   DateTime    @default(now())
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  commands AgentCommand[]

  @@index([tenantId])
  @@index([deviceId])
  @@index([status])
  @@map("device_agents")
}

model AgentPairingCode {
  id          String    @id @default(uuid())
  tenantId    String
  deviceId    String
  codeHash    String    @unique // HMAC-SHA256 Hash
  salt        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  isConsumed  Boolean   @default(false)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([deviceId])
  @@index([codeHash])
  @@map("agent_pairing_codes")
}

model AgentPairingAttempt {
  id            String    @id @default(uuid())
  clientKey     String    @unique // SHA-256 of IP + User-Agent + Client Fingerprint
  attempts      Int       @default(1)
  lockedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientKey])
  @@index([lockedUntil])
  @@map("agent_pairing_attempts")
}

enum AgentCommandStatus {
  PENDING
  DISPATCHED
  COMPLETED
  FAILED
  EXPIRED
}

model AgentCommand {
  id           String             @id @default(uuid())
  tenantId     String
  deviceId     String
  agentId      String
  operationId  String             @unique // UUID for strict deduplication / idempotency
  type         String             // e.g. "system.router.health", "hotspot.user.batch_add"
  payload      Json               // Typed payload matching whitelisted DTOs
  status       AgentCommandStatus @default(PENDING)
  result       Json?              // Output returned by the agent
  errorMessage String?
  attempts     Int                @default(0)
  maxAttempts  Int                @default(3)
  createdAt    DateTime           @default(now())
  dispatchedAt DateTime?
  completedAt  DateTime?
  expiresAt    DateTime

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  agent  DeviceAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([deviceId])
  @@index([agentId])
  @@index([status])
  @@index([agentId, status])
  @@map("agent_commands")
}

// =============================================================================
// BROADBAND / PPPOE SUBSCRIBER NETWORK
// =============================================================================

model PppoeProfile {
  id            String   @id @default(uuid())
  tenantId      String
  deviceId      String
  name          String   // e.g. "4Mbps-Home", "10Mbps-Fiber"
  rateLimit     String?  // e.g. "4M/8M" (rx/tx limit in MikroTik format)
  localAddress  String?  // Gateway IP or pool name
  remoteAddress String?  // Client IP pool name (e.g. "pppoe-pool")
  dnsServers    String?  // e.g. "8.8.8.8,1.1.1.1"
  onlyOne       Boolean  @default(true) // maps to only-one=yes
  price         Decimal  @default(0) @db.Decimal(10, 2)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device   MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  accounts PppoeAccount[]

  @@unique([tenantId, deviceId, name])
  @@index([tenantId])
  @@index([deviceId])
  @@map("pppoe_profiles")
}

model PppoeAccount {
  id                String             @id @default(uuid())
  tenantId          String
  deviceId          String
  profileId         String
  username          String
  passwordEncrypted String             // AES-256-GCM encrypted
  iv                String             // Hex IV
  authTag           String             // Hex auth tag
  status            PppoeAccountStatus @default(ACTIVE)
  callerId          String?            // Optional MAC address lock
  staticIp          String?            // Optional static remote-address
  customerName      String?
  customerPhone     String?
  price             Decimal            @db.Decimal(10, 2)
  billingCycle      BillingCycle       @default(MONTHLY)
  expiresAt         DateTime?
  notes             String?
  syncStatus        SyncStatus         @default(PENDING)
  syncError         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device         MikroTikDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  profile        PppoeProfile         @relation(fields: [profileId], references: [id], onDelete: Restrict)
  activeSessions PppoeActiveSession[]

  @@unique([tenantId, deviceId, username])
  @@index([tenantId])
  @@index([deviceId])
  @@index([profileId])
  @@index([status])
  @@index([syncStatus])
  @@index([expiresAt])
  @@index([tenantId, status])
  @@index([tenantId, deviceId, status])
  @@map("pppoe_accounts")
}

model PppoeActiveSession {
  id            String   @id @default(uuid())
  tenantId      String
  deviceId      String
  accountId     String?
  username      String
  ipAddress     String
  macAddress    String?  // Caller ID in RouterOS
  uptimeSeconds Int      @default(0)
  bytesIn       BigInt   @default(0)
  bytesOut      BigInt   @default(0)
  sessionId     String?
  startedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device  MikroTikDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  account PppoeAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([deviceId])
  @@index([accountId])
  @@index([username])
  @@map("pppoe_active_sessions")
}

