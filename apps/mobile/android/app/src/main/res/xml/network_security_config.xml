<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, disallow all cleartext HTTP traffic across the app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext HTTP exclusively for local private LAN router discovery & setup -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.88.1</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">10.5.50.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
