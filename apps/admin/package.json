{
  "name": "@mikrotik-saas/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @mikrotik-saas/shared-types build && pnpm --filter @mikrotik-saas/shared-validation build && tsc && vite build",
