+        host,
+        port,
+        timeout: timeout,
+        onBadCertificate: (_) => true,
+      );
+    } else {
+      _socket = await Socket.connect(host, port, timeout: timeout);
+    }
+
+    _sub = _socket!.listen(
+      (chunk) {
+        _buffer.add(chunk);
+        _drainFrames();
+      },
+      onError: (err) {
+        if (!_sentenceController.isClosed) {
+          _sentenceController.addError(err);
+        }
