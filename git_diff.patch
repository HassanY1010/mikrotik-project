+      ScaffoldMessenger.of(context).showSnackBar(
+        SnackBar(
+          content: Text(res['postRebootNotice']?.toString() ?? 'تم بدء الاستعادة وإعادة تشغيل الراوتر.'),
+          backgroundColor: ProvisioningThemeColors.primary,
+        ),
+      );
