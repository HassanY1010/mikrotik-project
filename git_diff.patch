+}
+
+describe('ConfigurationPlannerService & ProvisioningValidatorService', () => {
+  let validator: ProvisioningValidatorService;
+  let signingService: PlanSigningService;
+  let planner: ConfigurationPlannerService;
+
+  beforeEach(() => {
