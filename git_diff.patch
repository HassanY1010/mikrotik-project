+  const storageSvc = {
+    isConfigured: () => storageUploaded,
+    uploadPrivateObject: jest.fn().mockImplementation(({ storagePath, buffer }: any) => {
+      if (!storageUploaded) return Promise.resolve({ uploaded: false, bucket: 'router-backups', storagePath: '' });
