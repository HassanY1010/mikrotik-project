+      if (cmd === '/ip/dns/set') {
+        if (attrs.servers !== undefined) dnsServers = attrs.servers.split(',').filter(Boolean);
+        if (attrs['allow-remote-requests'] !== undefined) dnsAllowRemote = attrs['allow-remote-requests'] === 'yes';
