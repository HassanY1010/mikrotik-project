+          subtitle: 'التوافق المختار: ${p.osFamily} (${p.rosVersion})',
+          icon: Icons.compare_arrows_rounded,
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              SwitchListTile(
+                contentPadding: EdgeInsets.zero,
