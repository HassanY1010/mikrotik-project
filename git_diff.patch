+    expect(plan.canProceed).toBe(false);
+  });
+
+  it('Management Safety Fail-Closed: blocks direct management port inside LAN memberInterfaces', () => {
+    const discovery = buildDiscoveryFixture(); // management IP 192.168.50.1 on ether4
