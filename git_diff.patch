+      mockDevicesService,
+      mockDiscoverySvc,
+      new RouterCompatibilityService(),
+      planner,
+      {} as any,
+      {} as any,
+      {} as any,
+      mockExecutor,
+      signingService,
+      { log: jest.fn() } as any,
+    );
+
+    const dtoWithTamperedToken: StartAutoProvisioningDto = {
+      ...makeConfigDto(),
