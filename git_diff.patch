+  @IsOptional()
+  enabled?: boolean;
+
+  @ApiPropertyOptional({ example: 'SudaFi-Hotspot' })
+  @IsString()
+  @IsOptional()
+  @MinLength(1)
+  @MaxLength(32)
+  @Matches(SAFE_LABEL_REGEX)
+  ssid?: string;
+
+  @ApiPropertyOptional()
+  @IsString()
+  @IsOptional()
+  @MinLength(8)
+  @MaxLength(63)
+  @Matches(SAFE_LABEL_REGEX)
+  password?: string;
+
+  @ApiPropertyOptional({ example: 'Sudan', description: 'Regulatory country domain (never hardcoded)' })
+  @IsString()
+  @IsOptional()
+  @MaxLength(32)
+  @Matches(/^[a-zA-Z ]+$/)
