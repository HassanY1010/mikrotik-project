+        }
+        if (basePath === '/ip/firewall/mangle') {
+          mangleRules.push({ id: ret, chain: attrs.chain, action: attrs.action, comment: attrs.comment, disabled: false });
+        }
+        if (basePath === '/ip/firewall/filter') {
