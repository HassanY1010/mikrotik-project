# =============================================================================
# MikroTik SaaS Platform — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Only .env.example is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
APP_NAME="MikroTik SaaS API"
APP_VERSION=1.0.0

# API base URL (used for generating links in emails, webhooks, etc.)
APP_URL=https://mikrotik-api-yn0e.onrender.com
FRONTEND_URL=https://mikrotik-admin.onrender.com
CORS_ORIGINS=https://mikrotik-admin.onrender.com,http://localhost:5173,*

# Request ID header name
REQUEST_ID_HEADER=X-Request-Id

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://mikrotik_user:CHANGE_ME_DB_PASSWORD@localhost:5432/mikrotik_saas?schema=public"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mikrotik_saas
DATABASE_USER=mikrotik_user
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Redis DB number (0-15)
REDIS_DB=0
# Full URL alternative (takes precedence if set)
# REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Access token: short-lived (15 minutes recommended)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS_RANDOM
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token: longer-lived (7 days recommended)
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS_DIFFERENT_FROM_ACCESS
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Encryption (for MikroTik credentials at rest)
# -----------------------------------------------------------------------------
# Must be exactly 32 bytes (256 bits) for AES-256-GCM
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_EXACTLY_32_BYTES_AES256_KEY_HERE0000000

# -----------------------------------------------------------------------------
# Argon2id Password Hashing
# -----------------------------------------------------------------------------
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Auth endpoints (per IP, per window)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# General API endpoints (per user/IP, per window)
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300

# -----------------------------------------------------------------------------
# BullMQ / Background Jobs
# -----------------------------------------------------------------------------
BULL_CONCURRENCY_CARD_GENERATION=5
BULL_CONCURRENCY_MIKROTIK_SYNC=3
BULL_MAX_RETRIES=3
BULL_BACKOFF_DELAY_MS=5000

# Redis connection for BullMQ (usually same as main Redis)
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
BULL_REDIS_DB=1

# -----------------------------------------------------------------------------
# Email (for password reset, subscription notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_NAME="MikroTik SaaS"
SMTP_FROM_ADDRESS=noreply@example.com

# -----------------------------------------------------------------------------
# Super Admin (seeded on first run)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=superadmin@mikrotik-saas.local
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# Options: json | pretty (use 'json' in production, 'pretty' in development)
LOG_FORMAT=pretty
# Log file path (optional, leave empty to log to stdout only)
LOG_FILE=

# -----------------------------------------------------------------------------
# Swagger / OpenAPI
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
# Disable in production by setting to false
# SWAGGER_ENABLED=false

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Session / Cookie Security
# -----------------------------------------------------------------------------
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET_MIN_32_CHARS
COOKIE_SECURE=false
# Set to true in production (requires HTTPS)
# COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# MikroTik Integration
# -----------------------------------------------------------------------------
# Default connection timeout in milliseconds
MIKROTIK_CONNECTION_TIMEOUT_MS=10000
# Default socket timeout
MIKROTIK_SOCKET_TIMEOUT_MS=30000
# Max concurrent connections per device
MIKROTIK_MAX_CONCURRENT_CONNECTIONS=3

# -----------------------------------------------------------------------------
# File Storage (for logos, templates)
# -----------------------------------------------------------------------------
# Options: local | s3
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# S3 settings (only if STORAGE_TYPE=s3)
# STORAGE_S3_BUCKET=my-bucket
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Health Check
# -----------------------------------------------------------------------------
HEALTH_CHECK_DISK_THRESHOLD_PERCENT=90
HEALTH_CHECK_MEMORY_HEAP_THRESHOLD_MB=512
